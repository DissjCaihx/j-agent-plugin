<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jagent</groupId>
        <artifactId>j-agent-plugin</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>agent-plugin-bundle</artifactId>
    <packaging>pom</packaging>
    <dependencies>
        <dependency>
            <groupId>com.jagent</groupId>
            <artifactId>springboot-nacos-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.jagent</groupId>
            <artifactId>sermant-backend-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-info-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>runtime-info-plugin</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/plugins/runtime-info</outputDirectory>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-springboot-nacos-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>springboot-nacos-plugin</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/plugins/springboot-nacos</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <excludeTransitive>true</excludeTransitive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-springboot-nacos-runtime-libraries</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins/springboot-nacos/lib</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <excludeArtifactIds>runtime-info-plugin,springboot-nacos-plugin,agent-api
                            </excludeArtifactIds>
                            <excludeTransitive>false</excludeTransitive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-sermant-backend-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>sermant-backend-plugin</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/plugins/sermant-backend</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <excludeTransitive>true</excludeTransitive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-sermant-backend-runtime-libraries</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>asm,asm-commons,asm-tree</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/plugins/sermant-backend/lib</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <excludeTransitive>false</excludeTransitive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-info-descriptor</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins/runtime-info</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/../agent-plugins/runtime-info-plugin/src/main/resources
                                    </directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-springboot-nacos-descriptor</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins/springboot-nacos</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/../agent-plugins/springboot-nacos-plugin/src/main/resources
                                    </directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>config.properties.example</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-springboot-nacos-config-example</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins/springboot-nacos/conf</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/../agent-plugins/springboot-nacos-plugin/src/main/resources
                                    </directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>config.properties.example</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-sermant-backend-resources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins/sermant-backend</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/../agent-plugins/sermant-backend-plugin/src/main/resources
                                    </directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>config.properties.example</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-sermant-backend-config-example</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins/sermant-backend/conf</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.basedir}/../agent-plugins/sermant-backend-plugin/src/main/resources
                                    </directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>config.properties.example</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
